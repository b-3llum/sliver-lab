# ─────────────────────────────────────────────────────────────────────────
# sliver-lab environment.  Copy to ".env" and fill in.  NEVER commit .env.
#   cp .env.example .env   &&   scripts/setup.sh   (setup.sh can generate the token)
# ─────────────────────────────────────────────────────────────────────────

# Sliver operator config (.cfg). Leave empty to use the first *.cfg under
# ~/.sliver-client/configs/ (setup.sh generates one if none exist).
SLIVER_CFG_PATH=

# UI auth token (the single shared secret gating the browser UI).
# setup.sh will generate a strong random value if left as the placeholder.
SLIVER_UI_TOKEN=CHANGE_ME

# Backend bind (keep on localhost; see SECURITY in README).
HOST=127.0.0.1
PORT=8000

# ── avgen integration (OPTIONAL, user-supplied) ───────────────────────────
# The avgen implant builder is NOT shipped with this repo. Leave AVGEN_PATH
# empty to keep the Build tab's avgen panel disabled. To enable it, point this
# at your own avgen.py:
AVGEN_PATH=
AVGEN_PYTHON=python3
AVGEN_TIMEOUT=240
AVGEN_BUILD_DIR=/tmp/sliverui-builds

# ── ngrok (OPTIONAL public exposure) ──────────────────────────────────────
# Required only if you intend to expose a listener via the Listeners tab.
# The /api/ngrok routes return 503 until this is set. Get a token at
# https://dashboard.ngrok.com.  Read the SECURITY section before using this.
NGROK_AUTHTOKEN=
